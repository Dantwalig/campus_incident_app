rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Only verified ALU email addresses may use the app.
    function isAluVerified() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@(alustudent|alueducation)[.]com');
    }

    function isStaff() {
      return isAluVerified()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'staff';
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isStaff());
      // Self registration can only create a student profile.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'student'
        && request.auth.token.email.matches('.*@(alustudent|alueducation)[.]com');
      // Users can edit their profile but never change their own role.
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    match /incidents/{incidentId} {
      allow read: if isAluVerified();

      allow create: if isAluVerified()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.status == 'submitted'
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.title.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 10;

      allow update: if
        // Staff can only touch status related fields.
        (isStaff()
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'updatedAt', 'staffNote', 'statusHistory']))
        ||
        // Reporters can edit text while the report is still untouched.
        (isAluVerified()
          && resource.data.reporterId == request.auth.uid
          && resource.data.status == 'submitted'
          && request.resource.data.status == 'submitted'
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['title', 'description', 'updatedAt']));

      allow delete: if isAluVerified()
        && resource.data.reporterId == request.auth.uid
        && resource.data.status == 'submitted';
    }
  }
}
